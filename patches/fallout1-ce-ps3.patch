+    case 11: // Ucgen
+        return SDL_SCANCODE_C; // karakter ekrani
+    case 12: // R1
+        return SDL_SCANCODE_N; // silah modu degistir (intface_toggle_item_state)
+    case 13: // L1
+        return SDL_SCANCODE_B; // el degistir (slot 1<->2)
+    case 15: // L2
+        return SDL_SCANCODE_SPACE; // sira bitir (combat)
+    case 4: // Start
+        return SDL_SCANCODE_ESCAPE; // oyun menusu
+    case 7: // Select
+        return SDL_SCANCODE_TAB; // otomatik harita
+    case 3: // D-pad yukari
+        return SDL_SCANCODE_P; // PIP-Boy
+    case 1: // D-pad asagi
+        return SDL_SCANCODE_S; // Skilldex
+    case 0: // D-pad sol
+        return SDL_SCANCODE_A; // combat'a gir
+    case 2: // D-pad sag
+        return SDL_SCANCODE_RETURN; // combat'i bitir
+    default:
+        return SDL_SCANCODE_UNKNOWN;
+    }
+}
