+// PS3/newlib'de pthread yok, libstdc++ thread destegi olmadan derlenmis ->
+// std::recursive_mutex tanimsiz. SDL_mutex zaten recursive'dir; ayni
+// BasicLockable arayuzunu (lock/unlock) saglayan ince sarmalayici.
+class AudioMutex {
+public:
+    AudioMutex()
+        : mutex_(SDL_CreateMutex())
+    {
+    }
+    ~AudioMutex()
+    {
+        SDL_DestroyMutex(mutex_);
+    }
+    AudioMutex(const AudioMutex&) = delete;
+    AudioMutex& operator=(const AudioMutex&) = delete;
+    void lock()
+    {
+        SDL_LockMutex(mutex_);
+    }
+    void unlock()
+    {
+        SDL_UnlockMutex(mutex_);
+    }
+
+private:
+    SDL_mutex* mutex_;
+};
