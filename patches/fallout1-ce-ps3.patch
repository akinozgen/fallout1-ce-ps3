@@ -402,6 +402,8 @@
 // 0x442520
 static void swapUInt32(unsigned int* value)
 {
+#ifndef __PS3__
+    // bkz. swapUInt16 — PS3'te no-op.
     unsigned int swapped = *value;
     unsigned short high = swapped >> 16;
     // NOTE: Uninline.
@@ -410,14 +412,19 @@
     // NOTE: Uninline.
     swapUInt16(&low);
     *value = (low << 16) | high;
+#endif
 }
 
 // 0x442568
 static void swapUInt16(unsigned short* value)
 {
+#ifndef __PS3__
+    // .aaf dosyalari big-endian; little-endian hostta swap gerekir.
+    // Big-endian PS3'te veri zaten host sirasinda — swap YAPILMAZ.
     unsigned short swapped = *value;
     swapped = (swapped >> 8) | (swapped << 8);
     *value = swapped;
+#endif
 }
 
